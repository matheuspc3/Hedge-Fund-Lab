# Hedge-fund-lab · Environment Variables

# ── Banco de Dados ───────────────────────────────────────────
# PostgreSQL do docker-compose (default do código sem .env: sqlite:///hedgefundlab.db)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5435/hedgefundlab

# Docker Compose PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=hedgefundlab

# ── Logging ──────────────────────────────────────────────────
# Nível mínimo: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Caminho do arquivo de log (relativo à raiz do projeto)
LOG_FILE=data/logs/hedgefund.log

# ── Pipeline ─────────────────────────────────────────────────
# Lista JSON exigida pelo pydantic-settings
DEFAULT_TICKERS=["PETR4.SA","VALE3.SA","ITUB4.SA","BBDC4.SA","BBAS3.SA","ABEV3.SA","WEGE3.SA","CMIG4.SA","RENT3.SA","SUZB3.SA"]

# Período de análise
START_DATE=2016-01-01
END_DATE=2025-12-31

# Tamanho do batch para inserção no banco
BATCH_SIZE=1000

# Diretório de cache dos CSVs do yfinance
CACHE_DIR=data/raw

# ── LLM / Agent Router ───────────────────────────────────────
# Mock é o padrão seguro. Troque somente para uma execução real consciente.
LLM_PROVIDER=mock
# Preencha endpoint e modelo exatamente como documentados pelo provedor usado.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
