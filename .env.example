# Hedge-fund-lab · Environment Variables

# ── Banco de Dados ───────────────────────────────────────────
# PostgreSQL connection string (default: sqlite:///hedgefundlab.db)
DATABASE_URL=postgresql://user:password@localhost:5432/hedgefundlab

# Docker Compose PostgreSQL credentials
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=hedgefundlab

# ── Logging ──────────────────────────────────────────────────
# Nível mínimo: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Caminho do arquivo de log (relativo à raiz do projeto)
LOG_FILE=data/logs/hedgefund.log

# ── Pipeline ─────────────────────────────────────────────────
# Ticker(s) padrão (separados por vírgula)
DEFAULT_TICKERS=PETR4.SA,WEGE3.SA

# Período de análise
START_DATE=2016-01-01
END_DATE=2025-12-31

# Tamanho do batch para inserção no banco
BATCH_SIZE=1000

# Diretório de cache dos CSVs do yfinance
CACHE_DIR=data/raw
